{
  "name": "clothescad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first couture design CAD for women's garments: measurements in, beginner-ready patterns, instructions and 3D out.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "cli": "tsx cli/index.ts"
  },
  "dependencies": {
    "@use-gesture/react": "^10.3.1",
    "bezier-js": "^6.1.4",
    "clipper-lib": "^6.4.2",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svg2pdf.js": "^2.8.1",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bezier-js": "^4.1.3",
    "@types/clipper-lib": "^6.4.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xmldom/xmldom": "^0.9.12",
    "commander": "^15.0.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
